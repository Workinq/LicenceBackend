{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Enabled": true,
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Refresh": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Verify": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "VerifyPublicKey": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Admin": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    }
  },
  "LicenceCheckout": {
    "LeaseSeconds": 600,
    "HeartbeatHintSeconds": 300,
    "MinInstanceIdLength": 16,
    "MaxInstanceIdLength": 128,
    "SweepIntervalSeconds": 60
  }
}
