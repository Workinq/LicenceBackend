{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Session": {
    "Issuer": "",
    "Audience": "licencebackend-dashboard",
    "TtlSeconds": 900,
    "RefreshTtlSeconds": 2592000
  },
  "SessionSigning": {
    "Keys": [
      {
        "Kid": "session-v1",
        "PrivateKeyPath": "/etc/licencebackend/secrets/session-signing-key-v1.pem"
      }
    ],
    "ActiveKid": "session-v1"
  },
  "LicenceVerifySigning": {
    "Keys": [
      {
        "Kid": "licence-verify-v1",
        "PrivateKeyPath": "/etc/licencebackend/secrets/licence-verify-signing-key-v1.pem"
      }
    ],
    "ActiveKid": "licence-verify-v1"
  },
  "Licence": {
    "Peppers": [
      {
        "Version": 1,
        "Path": "/etc/licencebackend/secrets/licence-key-pepper-v1.txt"
      }
    ],
    "ActivePepperVersion": 1
  },
  "ProductImages": {
    "Directory": "/var/lib/licencebackend/product-images"
  },
  "ProductContentImages": {
    "Directory": "/var/lib/licencebackend/product-content-images"
  },
  "LicenceCheckout": {
    "LeaseSeconds": 600,
    "HeartbeatHintSeconds": 300,
    "MinInstanceIdLength": 16,
    "MaxInstanceIdLength": 128,
    "SweepIntervalSeconds": 60
  },
  "RateLimiting": {
    "Checkout": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "Heartbeat": {
      "PermitLimit": 12,
      "WindowSeconds": 60
    },
    "Checkin": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  }
}
